## Midnight Pulse cava config
[general]
framerate = 60
bars = 0
bar_width = 2
bar_spacing = 1
autosens = 1

[input]
method = pulse
source = auto

[output]
method = noncurses

[color]
gradient = 1
gradient_count = 6
gradient_color_1 = '#3D6BFF'
gradient_color_2 = '#2E86F5'
gradient_color_3 = '#1EB0EA'
gradient_color_4 = '#3EC3F2'
gradient_color_5 = '#5FD0FF'
gradient_color_6 = '#BDEBFF'

[smoothing]
noise_reduction = 66
monstercat = 1
