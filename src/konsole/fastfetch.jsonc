{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/midnight-pulse-logo.txt",
    "color": { "1": "38;2;95;208;255", "2": "38;2;61;107;255", "3": "38;2;255;255;255" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;30;176;234", "title": "38;2;95;208;255", "output": "38;2;220;232;255" },
    "key": { "width": 12 }
  },
  "modules": [
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "custom", "format": "\u001b[38;2;61;107;255m──────────── ✦ midnight pulse ✦ ────────────" },
    { "type": "os", "key": "  os" },
    { "type": "kernel", "key": "  kernel" },
    { "type": "de", "key": "  desktop" },
    { "type": "wm", "key": "  wm" },
    { "type": "theme", "key": "  theme" },
    { "type": "cpu", "key": "  cpu", "temp": true },
    { "type": "gpu", "key": "󰢮  gpu", "temp": true },
    { "type": "memory", "key": "  memory" },
    { "type": "disk", "key": "󰋊  disk", "folders": "/" },
    { "type": "uptime", "key": "  uptime" },
    { "type": "media", "key": "  playing", "format": "{artist} — {title}" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
